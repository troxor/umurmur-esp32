+static void write_pem_file(const char *path, const unsigned char *pem)
+{
+	FILE *fp = fopen(path, "w");
+	if (fp == NULL) {
+		Log_warn("Unable to open %s for writing", path);
 		return;
 	}
+	if (fputs((const char *)pem, fp) == EOF)
+		Log_warn("Unable to write %s", path);
+	fclose(fp);
