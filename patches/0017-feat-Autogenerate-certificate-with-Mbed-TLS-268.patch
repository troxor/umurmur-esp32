+int urandom_bytes(void *ctx, unsigned char *dest, size_t len)
+{
+	(void)ctx;
+	return UMURMUR_MBEDTLS_RNG(UMURMUR_MBEDTLS_RNG_CTX, dest, len);
+}
 
