-			bPreferAlpha = true;
-		else
-			bPreferAlpha = !bPreferAlpha;
-
-		if (bPreferAlpha)
-			iCodecAlpha = version;
-		else
-			iCodecBeta = version;
-	} else if (bOpus && enableOpus) {
-		if (connectingClient && !connectingClient->bOpus)
-			Client_textmessage(connectingClient, OPUS_WARN_USING);
-		return;
-	}
-
