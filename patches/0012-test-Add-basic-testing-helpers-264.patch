From 8e915e19675b259ab069a31cc7c85de8a97f2516 Mon Sep 17 00:00:00 2001
From: "Troy C." <327529+troxor@users.noreply.github.com>
Date: Sat, 22 Aug 2026 20:37:55 -0500
Subject: [PATCH 12/18] test: Add basic testing helpers (#264)

---
 CMakeLists.txt       |  6 ++++++
 hack/make-all.sh     | 20 ++++++++++++++++++++
 hack/remote-build.sh | 21 +++++++++++++++++++++
 3 files changed, 47 insertions(+)
 create mode 100755 hack/make-all.sh
 create mode 100755 hack/remote-build.sh

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ef13c86..8827465 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,6 +42,12 @@ check_function_exists(strlcpy HAVE_STRLCPY)
 
 add_subdirectory(src)
 
+enable_testing()
+add_test(NAME umurmurd-help COMMAND $<TARGET_FILE:umurmurd> -h)
+set_tests_properties(umurmurd-help PROPERTIES
+  PASS_REGULAR_EXPRESSION "Usage: umurmurd"
+)
+
 install(
   FILES "umurmur.conf.example"
   DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/umurmur"
diff --git a/hack/make-all.sh b/hack/make-all.sh
new file mode 100755
index 0000000..ecbcaf1
--- /dev/null
+++ b/hack/make-all.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env zsh
+
+# Quick-and-dirty build against all available SSL libraries
+
+export CODE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." && pwd -P)"
+export BUILD_TYPE=debug
+export SHMEM=true
+
+for S in mbedtls openssl gnutls; do
+	cd ${CODE_DIR}
+	rm -rf build-${S} && \
+	cmake -Bbuild-${S} -DSSL=${S} \
+		-DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
+		-DCMAKE_RULE_MESSAGES=ON \
+		-DUSE_SHAREDMEMORY_API=${SHMEM} \
+		&& \
+	cmake --build build-${S} && \
+	ctest --test-dir build-${S} --output-on-failure -V && \
+	cd -
+done
diff --git a/hack/remote-build.sh b/hack/remote-build.sh
new file mode 100755
index 0000000..22666bc
--- /dev/null
+++ b/hack/remote-build.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env zsh
+
+# Quick-and-dirty push to VMs for testing builds
+
+[[ -z $1 ]] && echo "Usage: $0 host1 ..."
+
+CODE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." && pwd -P)"
+
+for host in $@ ; do
+	rsync -az --delete --exclude .git ${CODE_DIR} $host:git/
+done
+
+for host in $@ ; do
+	echo -e "#\n# $host\n#"
+	ssh $host 'cd ~/git/umurmur && ./hack/make-all.sh'
+done
+
+for host in $@ ; do
+	echo $host
+	ssh $host 'ls -l ~/git/umurmur/build-*/src/umurmurd'
+done
