 src/CMakeLists.txt | 5 -----
 src/ban.c          | 2 --
 2 files changed, 7 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 39f2b52..92b0cde 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -49,12 +49,7 @@ set_target_properties(${PROJECT_NAME} PROPERTIES
 
 target_compile_definitions(${PROJECT_NAME} PRIVATE
   _GNU_SOURCE
-  _XOPEN_SOURCE=700
 )
-# _XOPEN_SOURCE hides BSD APIs on Darwin (initgroups).
-if(APPLE)
-  target_compile_definitions(${PROJECT_NAME} PRIVATE _DARWIN_C_SOURCE)
-endif()
 
 if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
   target_compile_options(${PROJECT_NAME} PRIVATE
diff --git a/src/ban.c b/src/ban.c
index ae532e4..ff764b9 100644
--- a/src/ban.c
+++ b/src/ban.c
@@ -29,8 +29,6 @@
    SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
    */
 
-#define _POSIX_C_SOURCE 200809L
-
 #include "ban.h"
 
 #include <stdlib.h>
