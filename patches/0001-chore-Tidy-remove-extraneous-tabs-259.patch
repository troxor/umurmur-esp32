-		pledge_promises = "stdio inet";
-		if (needs_filesystem)
-			pledge_promises = "stdio inet wpath cpath";
+	pledge_promises = "stdio inet";
+	if (needs_filesystem)
+		pledge_promises = "stdio inet wpath cpath";
 
-		if (pledge(pledge_promises, NULL) == -1)
-			Log_fatal("pledge (%s) failed: %s", pledge_promises, strerror(errno));
+	if (pledge(pledge_promises, NULL) == -1)
