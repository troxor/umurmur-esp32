+				conffile = optarg;
+				break;
+			case 'p':
+				pidfile = optarg;
+				break;
+			case 'a':
+				bindaddr = optarg;
+				break;
+			case 'A':
+				bindaddr6 = optarg;
+				break;
+			case 'b':
