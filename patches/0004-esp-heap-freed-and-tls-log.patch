From: umurmur-esp32 <noreply@local>
Subject: [PATCH] ESP heap: log after Client_free

- Log_info heap snapshot after Client_free (reconnect baseline).

diff --git a/src/client.c b/src/client.c
index 4f5b229..05ad66c 100644
--- a/src/client.c
+++ b/src/client.c
@@ -48,6 +48,7 @@
 #include "channel.h"
 #include "config.h"
 #include "voicetarget.h"
+#include "esp_heap_caps.h"
 #include "ban.h"
 #include "util.h"
 
@@ -268,6 +269,8 @@ void Client_free(client_t *client)
 	if (client->context)
 		free(client->context);
 	free(client);
+	Log_info("heap [freed] clients=%d free=%u", Client_count(),
+		(unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT));
 }
 
 void Client_close(client_t *client)
