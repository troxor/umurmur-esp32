diff --git a/src/messagehandler.c b/src/messagehandler.c
--- a/src/messagehandler.c
+++ b/src/messagehandler.c
@@ -55,15 +55,31 @@
 
 static void sendServerReject(client_t *client, const char *reason, MumbleProto__Reject__RejectType type)
 {
-	message_t *msg = Msg_create(Reject);
+	message_t *msg;
+
+	/* Drop Version etc. — Reject must be the only thing on the wire. */
+	Client_tx_clear(client);
+
+	msg = Msg_create(Reject);
 	msg->payload.reject->reason = strdup(reason);
 	msg->payload.reject->type = type;
 	msg->payload.reject->has_type = true;
 	Client_send_message(client, msg);
+	if (Client_flush_tx(client) != 0)
+		Log_warn("Reject not fully flushed (tx left=%u)", client->txsize);
 
 	Log_info_client(client, "Server reject reason: %s", reason);
 }
 
+void Mh_reject_server_full(client_t *client)
+{
+	char buf[64];
+
+	snprintf(buf, sizeof(buf), "Server is full (max %d users)", getIntConf(MAX_CLIENTS));
+	sendServerReject(client, buf, MUMBLE_PROTO__REJECT__REJECT_TYPE__ServerFull);
+	client->shutdown_wait = true;
+}
+
 static void sendPermissionDenied(client_t *client, const char *reason)
 {
 	message_t *msg = Msg_create(PermissionDenied);
@@ -178,9 +194,7 @@
 
 		/* Client_count includes this connecting client (not yet authenticated). */
 		if (Client_count() > getIntConf(MAX_CLIENTS)) {
-			char buf[64];
-			snprintf(buf, 64, "Server is full (max %d users)", getIntConf(MAX_CLIENTS));
-			sendServerReject(client, buf, MUMBLE_PROTO__REJECT__REJECT_TYPE__ServerFull);
+			Mh_reject_server_full(client);
 			goto disconnect;
 		}
 
@@ -953,6 +967,7 @@
 
 disconnect:
 	Msg_free(msg);
-	Client_close(client);
+	/* Don't SSLi_shutdown yet — let Reject flush, then Client_free. */
+	client->shutdown_wait = true;
 }
 
