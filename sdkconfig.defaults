CONFIG_IDF_TARGET="esp32"

# Disable Bluetooth to optimize available RAM on ESP32 Classic
CONFIG_BT_ENABLED=n

# Max sockets: up to 4 listen/UDP (v4+v6) + max_users (≤8) + 1 reject
# slot + captive-portal httpd.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_MSS=1436

# Confine main task's Stack size to allow for more client activity
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Trim unused features in Mbed TLS 4.x (ESP-IDF 6.1)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_PEM_PARSE_C=y
CONFIG_MBEDTLS_PK_WRITE_C=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y

# Console logging.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
